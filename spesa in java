class Articolo {
    String nome_articolo;
    String categoria;
    double prezzo;
    int quantita;

    Articolo(String nome_articolo, String categoria, double prezzo, int quantita) {
        this.nome_articolo = nome_articolo;
        this.categoria = categoria;
        this.prezzo = prezzo;
        this.quantita = quantita;
        }

        public String toString() {
            return nome_articolo + " (" + categoria + ") - " + quantita + " pezzi," + prezzo + " € cadauno";
        }
}

